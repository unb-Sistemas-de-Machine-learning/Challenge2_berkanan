# ==============================================================================
# Challenge 2 Berkanan — Exemplo de Variáveis de Ambiente (Desenvolvimento)
# ==============================================================================
# Copie este arquivo para `.env` em desenvolvimento local:
#   cp .env.example .env
# NUNCA versione chaves de API reais ou senhas de produção no repositório Git.

# --- Ambiente e Servidor FastAPI ---
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_HOST_BIND=127.0.0.1
BACKEND_PORT=8000

# --- Limites Mobile First (ADR-002) ---
# Meta de compressão no navegador mobile: JPEG ~1280px no maior lado, até ~300 KB
MAX_UPLOAD_BYTES=307200
TARGET_IMAGE_MAX_SIDE_PX=1280

# --- Banco Relacional PostgreSQL (ADR-001 e ADR-008) ---
# Nota: O serviço sobe via Docker Compose, mas a conexão no backend atual (v0.1.0) ainda está PENDENTE.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_BIND=127.0.0.1
POSTGRES_DB=berkanan_dev
POSTGRES_USER=berkanan_user
POSTGRES_PASSWORD=dev_only_change_me

# --- Banco Vetorial ChromaDB (ADR-001 e ADR-006) ---
# Nota: O serviço sobe via Docker Compose, mas a ingestão/consulta no backend atual ainda está PENDENTE.
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_HOST_BIND=127.0.0.1
CHROMA_HOST_PORT=8001
CHROMA_COLLECTION=base_conhecimento_v1
EMBEDDING_MODEL=not_configured

# --- Modelos de Linguagem e Agentes (ADR-004, ADR-005 e ADR-006) ---
LLM_PROVIDER=gemini
LLM_MODEL=not_configured
LLM_FALLBACK_MODEL=not_configured
GEMINI_API_KEY=replace_with_your_local_key_do_not_commit
ENABLE_VERIFIER_DEFAULT=true
MAX_LLM_CALLS_PER_RESPONSE=2

# --- OCR (ADR-002 — Escolha entre Tesseract e PaddleOCR pendente de benchmark) ---
OCR_ENGINE=not_configured
