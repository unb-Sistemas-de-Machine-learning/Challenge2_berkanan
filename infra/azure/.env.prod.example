# ==============================================================================
# Challenge 2 Berkanan — Exemplo de Variáveis de Ambiente (Staging/Produção Azure)
# ==============================================================================
# Na VM Azure (`brazilsouth`), copie para `infra/azure/.env.prod` e preencha
# os segredos reais antes de executar `bash infra/azure/bootstrap_stack.sh`.
# NUNCA versione chaves de API ou senhas reais no repositório Git.

# --- Ambiente, Domínio TLS e Segurança de Borda (Caddy) ---
# Nota: usamos subdomínio dedicado gratuito (ex.: DuckDNS) apontando para o IP estático da VM
# para evitar o rate limit compartilhado do Let's Encrypt sobre *.brazilsouth.cloudapp.azure.com.
APP_ENV=staging
LOG_LEVEL=INFO
API_DOMAIN=berkanan-challenge-2.duckdns.org
CORS_ALLOWED_ORIGIN=https://berkanan-web.azurestaticapps.net
CADDY_MAX_BODY_SIZE=512KB

# --- Imagem do Backend (GHCR + fallback de build local na VM) ---
# Por padrão (USE_GHCR=1), o bootstrap faz `docker compose pull backend` a partir
# do GitHub Container Registry (ghcr.io) para evitar consumo de disco/CPU na VM.
# Defina USE_GHCR=0 para forçar build local via Dockerfile na VM.
BACKEND_IMAGE=ghcr.io/unb-sistemas-de-machine-learning/challenge2-backend:prod
USE_GHCR=1

# --- Limites Mobile First (ADR-002) ---
MAX_UPLOAD_BYTES=307200
TARGET_IMAGE_MAX_SIDE_PX=1280

# --- PostgreSQL 16.4 (ADR-001 e ADR-008) ---
POSTGRES_DB=berkanan_prod
POSTGRES_USER=berkanan_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

# --- ChromaDB 0.5.20 (ADR-001 e ADR-006) ---
CHROMA_COLLECTION=base_conhecimento_v2
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- LLM e Agentes (ADR-004, ADR-005 e ADR-006) ---
LLM_PROVIDER=gemini
LLM_MODEL=not_configured
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
LLM_FALLBACK_MODEL=not_configured
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
ENABLE_VERIFIER_DEFAULT=true
MAX_LLM_CALLS_PER_RESPONSE=2
RAG_WARMUP_TIMEOUT_SECONDS=20

# --- OCR (ADR-002 — escolha definitiva via benchmark #24) ---
OCR_ENGINE=not_configured
